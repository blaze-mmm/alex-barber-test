import asyncio
from aiogram import Bot, Dispatcher, types, F
from aiogram.filters import CommandStart
from aiogram.types import InlineKeyboardMarkup, InlineKeyboardButton

TOKEN = os. getenv( "BOT_TOKEN" )
ADMIN_ID =  int(os.getenv( "BARBER_ID", "0"))

bot = Bot(token=TOKEN)
dp = Dispatcher()

# Главное меню
def main_menu():
    buttons = [
        [InlineKeyboardButton(text="✂️ Записаться", callback_data="book")],
        [InlineKeyboardButton(text="💈 Прайс-лист", callback_data="price")],
        [InlineKeyboardButton(text="📍 Адрес и контакты", callback_data="contacts")]
    ]
    return InlineKeyboardMarkup(inline_keyboard=buttons)

@dp.message(CommandStart())
async def cmd_start(message: types.Message):
    await message.answer(
        f"Привет, {message.from_user.first_name}! Добро пожаловать в **Alex Barber**.\nВыбери нужное действие:",
        reply_markup=main_menu(),
        parse_mode="Markdown"
    )

@dp.callback_query(F.data == "price")
async def show_price(callback: types.CallbackQuery):
    text = (
        "**Прайс-лист Alex Barber:**\n\n"
        "• Мужская стрижка — 1000 ₽\n"
        "• Оформление бороды — не пмоню ахха ₽\n"
        "• Комплекс (Стрижка + Борода) — хз ₽"
    )
    await callback.message.edit_text(text, reply_markup=main_menu(), parse_mode="Markdown")

@dp.callback_query(F.data == "contacts")
async def show_contacts(callback: types.CallbackQuery):
    text = "📍 **Адрес:** ул. каки, 10\n📞 **Телефон:** +сиси"
    await callback.message.edit_text(text, reply_markup=main_menu(), parse_mode="Markdown")

@dp.callback_query(F.data == "book")
async def start_booking(callback: types.CallbackQuery):
    # Здесь подключается выбор услуги и генерация свободных слотов из базы данных
    buttons = [
        [InlineKeyboardButton(text="Мужская стрижка", callback_data="srv_haircut")],
        [InlineKeyboardButton(text="Оформление бороды", callback_data="srv_beard")],
        [InlineKeyboardButton(text="⬅️ Назад", callback_data="back_main")]
    ]
    await callback.message.edit_text("Выбери услугу:", reply_markup=InlineKeyboardMarkup(inline_keyboard=buttons))

@dp.callback_query(F.data == "back_main")
async def back_to_main(callback: types.CallbackQuery):
    await callback.message.edit_text("Главное меню:", reply_markup=main_menu())

async def main():
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
